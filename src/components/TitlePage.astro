---
import Title from './Title.astro'
import Shape from './icons/Shape.astro'
type Props = {
	title: string
}

const { title } = Astro.props
---

<div class='flex flex-col gap-3 mb-8 title'>
	<div class='flex items-center gap-3'>
		<div class='p-2 bg-primary-600 rounded-md'>
			<Shape />
		</div>
		<Title>{title}</Title>
	</div>
	<div class='h-0.5 w-16 bg-primary-600 rounded-full'></div>
</div>
