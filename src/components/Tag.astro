---
export interface Props {
	tag: string
}
const { tag } = Astro.props
---

<a href={`/blog/tags/${encodeURIComponent(tag.toLowerCase())}`} aria-label={tag} class='inline-block'>
	<span
		class='bg-gray-100 dark:bg-gray-800 hover:bg-primary-50 dark:hover:bg-primary-900/20 text-gray-700 dark:text-gray-300 hover:text-primary-700 dark:hover:text-primary-400 border border-gray-200 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-700 font-medium text-xs md:text-sm w-fit px-2.5 py-1 md:px-4 md:py-1.5 rounded-md transition-all duration-200 cursor-pointer inline-flex items-center gap-1.5'
	>
		<span class='text-[10px] md:text-xs opacity-60'>#</span>
		<span>{tag ?? 'Blog Tag'}</span>
	</span>
</a>
